BUILD_DIR ?= build/auth
BUILD_TYPE ?= Release
USER_NAME ?= $(USER)
SESSION ?= test
SUDO ?= sudo

.PHONY: build install test clean

build:
	cmake -S auth -B $(BUILD_DIR) -DCMAKE_BUILD_TYPE=$(BUILD_TYPE)
	cmake --build $(BUILD_DIR) -j$$(nproc)

install: build
	$(SUDO) cmake --install $(BUILD_DIR)

test: build
	$(BUILD_DIR)/pam/biopass-helper auth -u "$(USER_NAME)" -s "$(SESSION)"

clean:
	rm -rf $(BUILD_DIR)
